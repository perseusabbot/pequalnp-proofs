/-- Each search node selects a cell. All viable slot and phase choices below it are checked. -/
theorem exhausted : ∀ f, ¬search.compatible f := by
  have start : states.domain 2243=82631996098781074868989413504096379978550585370535152410581099409300723904538918228148651304964410605948901503127919788031 ∧ states.used 2243=0 := by decide +kernel
  have spare : Search.free (n:=45) (s:=3) (p:=3) (states.domain 2243) (states.used 2243) := by
    rw [start.1,start.2]; unfold Search.free; decide +kernel
  intro f good
  exact search.sound states 2244 (fun v hv => nodesValid v (Nat.zero_le _) hv) 2243 (by decide) spare f good
    (fun i => spare i _ _ (start.2 ▸ Nat.zero_le _))

/-- Even with arbitrarily many invariant legal rectangles, these moving slots cannot cover the board. -/
theorem movingLower (family : Fin 3 → Box) (law : ∀t, legal (family t))
    (cover : ∀ x y : V, bit x y=false →
      (∃ b, legal b ∧ rotation.stable b ∧ hit b x y) ∨ ∃t,rotation.meets 3 (family t) x y) : False := by
  apply rotation.boundary search point (by decide +kernel) (by decide +kernel) _ exhausted family law cover
  decide +kernel

