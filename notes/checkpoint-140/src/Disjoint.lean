private theorem allSlices : ValidOn testPair 0 1205 := (combine (combine (combine (combine pairSlice0 (combine pairSlice40 pairSlice80)) (combine (combine pairSlice120 pairSlice160) (combine pairSlice200 pairSlice240))) (combine (combine (combine pairSlice280 pairSlice320) (combine pairSlice360 pairSlice400)) (combine (combine pairSlice440 pairSlice480) (combine pairSlice520 pairSlice560)))) (combine (combine (combine (combine pairSlice600 pairSlice640) (combine pairSlice680 pairSlice720)) (combine (combine pairSlice760 pairSlice800) (combine pairSlice840 pairSlice880))) (combine (combine (combine pairSlice920 pairSlice960) (combine pairSlice1000 pairSlice1040)) (combine (combine pairSlice1080 pairSlice1120) (combine pairSlice1160 pairSlice1200)))))
theorem disjointTile {o : O} (s : V) (ordinary : ovalType o = none) :
    tally (tile o s) disjointWeight ≤ 28 := by
  have a := allSlices o.val (by omega) o.isLt
  simp only [testPair,Fin.ofNat_val_eq_self,ordinary,Option.isSome_none,Bool.false_or] at a
  have d := scanned _ 0 21 a s.val (by omega) s.isLt
  simpa only [readTile,decide_eq_true_eq] using d

theorem disjointPairImpossible (T : Finset Box) (budget : T.card ≤ 11) (ok : family T)
    (exceptional : ∀ b ∈ T, ∀ h : H, ¬fits b (oval h)) : ¬covered [13,14] T := by
  intro cov
  have bound (b : Box) (hb : b ∈ T) : tally b disjointWeight ≤ 28 := by
    obtain ⟨o,s,sub⟩ := containingTile b.1 b.2 (ok b hb)
    cases h : ovalType o with
    | none => exact (tallyMono sub _).trans (disjointTile s h)
    | some j =>
      rw [specialTile h s] at sub
      exact False.elim (exceptional b hb _ sub)
  have keep (p q : V) (pos : 0 < disjointWeight p q) : ∃ b ∈ T, hit b p q := by
    obtain ⟨zero,a,b⟩ := disjointTotals.2 p q pos
    rcases cov p q zero with ⟨j,hj,inJ⟩ | yes
    · simp only [List.mem_cons,List.not_mem_nil,or_false] at hj
      rcases hj with rfl|rfl
      · exact False.elim (a inJ)
      · exact False.elim (b inJ)
    · exact yes
  have lo := weightCovered T disjointWeight keep
  rw [disjointTotals.1] at lo
  have hi : (∑ b ∈ T, tally b disjointWeight) ≤ T.card * 28 := by
    calc
      _ ≤ ∑ _b ∈ T, (28 : ℕ) := sum_le_sum bound
      _ = _ := by simp
  have lim := Nat.mul_le_mul_right 28 budget
  omega

