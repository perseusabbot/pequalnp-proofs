private def shiftWord (p q : V) : Nat := (shiftWords[p.val]!)[q.val]!

set_option maxHeartbeats 0 in
private theorem shiftWordSpec : ∀ p q : V,
    encode 1024 21 (fun j => disjointWeight (p + Fin.ofNat 21 j) (q + Fin.ofNat 21 j)) =
      shiftWord p q := by decide +kernel

private theorem packTile (o : O) :
    encode 1024 21 (fun j => tally (tile o (Fin.ofNat 21 j)) disjointWeight) =
      tally (tile o 0) shiftWord := by
  simp only [tallyShift o _ disjointWeight,encodeTally,shiftWordSpec]

private theorem readTile (o : O) (s : V) :
    component 1024 s.val (tally (tile o 0) shiftWord) = tally (tile o s) disjointWeight := by
  have small (j : Nat) (_ : j < 21) :
      tally (tile o (Fin.ofNat 21 j)) disjointWeight < 1024 := by
    have le := tallyMono (b := tile o (Fin.ofNat 21 j)) (c := (univ,univ))
      ⟨subset_univ _,subset_univ _⟩ disjointWeight
    rw [disjointTotals.1] at le
    omega
  have d := readDigit 1024 21 (fun j => tally (tile o (Fin.ofNat 21 j)) disjointWeight) small s.isLt
  rw [packTile] at d
  simpa only [Fin.ofNat_val_eq_self] using d

private def testPair (i : Nat) : Bool :=
  let o : O := Fin.ofNat 1205 i
  let word := tally (tile o 0) shiftWord
  (ovalType o).isSome || scan (fun j => decide (component 1024 j word ≤ 28)) 0 21

