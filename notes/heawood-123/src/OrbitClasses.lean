private def correct (entry : ℕ × ℕ × ℕ) : Bool :=
  decide (entry.2.1 ∈ representatives ∧
    (decode entry.2.1).image (Sym2.map (relabel entry.2.2))=decode entry.1)

private theorem allCorrect : certificates.all correct=true := by
  set_option maxRecDepth 30000 in
  set_option maxHeartbeats 0 in
  decide +kernel

private theorem allCovered : candidates.all (fun m => (certificates.map Prod.fst).contains m)=true := by
  set_option maxRecDepth 30000 in
  set_option maxHeartbeats 0 in
  decide +kernel

/-- Each omitted edge set in the six-center census is the image of one of
three explicit representatives under a Heawood graph automorphism. -/
theorem threeRepresentatives {L : Finset (Sym2 V)} (h : SixCenterOption L) :
    ∃ r∈representatives, ∃ f : G ≃g G, (decode r).image (Sym2.map f)=L := by
  obtain ⟨m,hm,rfl⟩ := encodedOption h
  have mem := List.all_eq_true.mp allCovered m hm
  obtain ⟨entry,he,hit⟩ := List.mem_map.mp (List.contains_iff_mem.mp mem)
  have checked : entry.2.1∈representatives ∧
      (decode entry.2.1).image (Sym2.map (relabel entry.2.2))=decode entry.1 :=
    of_decide_eq_true (List.all_eq_true.mp allCorrect entry he)
  exact ⟨entry.2.1,checked.1,relabel entry.2.2,checked.2.trans (congrArg decode hit)⟩

#print axioms threeRepresentatives
end Checkpoint123.Symmetry
