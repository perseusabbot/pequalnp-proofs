private def move (b : Bool) (v : V) : V :=
  if b then ([0,2,3,6,5,4,1,8,7,13,10,9,11,12] : List V).getD v.val 0
  else Fin.ofNat 14 (v.val+7)

private def undo (b : Bool) (v : V) : V :=
  if b then ([0,6,1,2,5,4,3,8,7,11,10,12,13,9] : List V).getD v.val 0
  else Fin.ofNat 14 (v.val+7)

private theorem permutations : ∀ b : Bool, (∀ v, undo b (move b v)=v ∧ move b (undo b v)=v) ∧
    (∀ u v, G.Adj (move b u) (move b v) ↔ G.Adj u v) := by decide +kernel

private def generator (b : Bool) : G ≃g G where
  toFun := move b
  invFun := undo b
  left_inv v := ((permutations b).1 v).1
  right_inv v := ((permutations b).1 v).2
  map_rel_iff' := (permutations b).2 _ _

/-- Read the digits after the leading binary 1 from left to right. -/
def relabel (word : ℕ) : G ≃g G :=
  ((List.range (Nat.log2 word)).reverse).foldl
    (fun (f : G ≃g G) i => f.trans (generator (word.testBit i))) SimpleGraph.Iso.refl

